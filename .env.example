# Configuração do Supabase para o W&E.Agenda (Etapa 2)
# Obtenha estas credenciais no painel do seu projeto Supabase: https://supabase.com/dashboard/project/_/settings/api

# URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave pública anon (segura para uso no frontend com Row Level Security ativado)
# NUNCA insira a service_role key aqui!
VITE_SUPABASE_ANON_KEY=your-anon-public-key
